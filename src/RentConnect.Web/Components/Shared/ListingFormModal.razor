    private record MediaTile(string PreviewSource, string FileName, bool IsVideo, bool IsNew, Guid? ExistingImageId, SelectedImage? PendingImage);

    private record SelectedDocument(string FileName, byte[] Bytes, string? DataUrl, bool IsImage);

